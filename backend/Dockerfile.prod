# Backend Dockerfile for Production
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create directories
RUN mkdir -p logs models videos

EXPOSE 8000

# Run with Gunicorn for production checks
# Note: Since we use Websockets, we stick with uvicorn workers or pure uvicorn
# CRITICAL: Use 1 worker for MVP to avoid multiple processes fighting for the single camera (index 0)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
