# Database Configuration
DATABASE_URL=postgresql://ssis_user:ssis_password_2024@localhost:5432/ssis_inventory
MONGODB_URL=mongodb://ssis_admin:ssis_mongo_2024@localhost:27017/ssis_events?authSource=admin
REDIS_URL=redis://localhost:6379

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Video Source Configuration
VIDEO_SOURCE=0  # 0 for webcam, or path to video file
CAMERA_FPS=30
FRAME_SKIP=2  # Process every Nth frame for performance

# AI Model Configuration
YOLO_MODEL=yolov8n.pt  # yolov8n.pt, yolov8s.pt, yolov8m.pt, yolov8l.pt, yolov8x.pt
CONFIDENCE_THRESHOLD=0.5
IOU_THRESHOLD=0.45
TRACKING_MAX_AGE=30
TRACKING_MIN_HITS=3

# Alert Configuration
ENABLE_EMAIL_ALERTS=true
ENABLE_WHATSAPP_ALERTS=false
ENABLE_WEBSOCKET_ALERTS=true

# Email Configuration (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_EMAIL_TO=manager@supermarket.com

# WhatsApp Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+1234567890

# Inventory Sync Configuration
SYNC_INTERVAL_SECONDS=10
MISMATCH_THRESHOLD=2  # Alert when difference >= this value

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/ssis.log

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000